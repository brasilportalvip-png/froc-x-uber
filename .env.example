# ============ Froc X Uber · variáveis do servidor ============
# Guia passo a passo: CONFIGURACAO.md

# Firebase (login, banco de dados e documentos dos motoristas)
# JSON inteiro da chave de serviço (Firebase > Configurações do projeto > Contas de serviço > Gerar nova chave privada)
FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}'
# JSON da configuração web (Firebase > Configurações do projeto > Seus apps > App da Web > firebaseConfig)
FIREBASE_WEB_CONFIG='{"apiKey":"...","authDomain":"...","projectId":"...","storageBucket":"...","appId":"..."}'

# Só se o Firestore não for o banco "(default)" (projetos do AI Studio às vezes usam outro nome)
# FIRESTORE_DATABASE_ID="ai-studio-..."

# E-mails que podem aprovar motoristas e pagar saques (separados por vírgula; precisam estar verificados)
ADMIN_EMAILS="voce@exemplo.com"

# Endereço público do site, sem barra no final (usado na volta do Mercado Pago)
PUBLIC_SITE_URL="https://froc-x-uber.vercel.app"

# Mercado Pago (recargas da carteira por Pix e cartão)
MERCADO_PAGO_ACCESS_TOKEN="APP_USR-..."
# Chave secreta das notificações (Mercado Pago > Suas integrações > Webhooks > Assinatura secreta)
MERCADO_PAGO_WEBHOOK_SECRET="..."

# Senha do agendador dos prazos automáticos (POST /api/cron/sweep com cabeçalho x-cron-key)
CRON_SECRET="uma-senha-longa"

# Google Maps (mapa, rotas e busca de endereços)
VITE_GOOGLE_MAPS_API_KEY="..."

# Gemini (já usado pelo AI Studio)
GEMINI_API_KEY="..."
